.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e4ebf6;
  box-shadow: 0 -6rpx 24rpx #3a679014;
  z-index: 9999;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8798ae;
  font-size: 22rpx;
}

.tab-bar-item.active {
  color: #3f7de4;
}

.icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 4rpx;
}

.text {
  line-height: 1.2;
}
