.header {
  padding: 24rpx 0 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.brand-row { display: flex; align-items: center; gap: 16rpx; }
.logo { width: 64rpx; height: 64rpx; border-radius: 16rpx; }
.brand { font-size: 36rpx; font-weight: 900; color: #203d72; letter-spacing: 2rpx; }
.sub { font-size: 22rpx; color: #7185a4; }

.info {
  margin-top: 24rpx;
  padding: 48rpx;
  background: #fff;
  border: 1rpx solid #dfe9f6;
  border-radius: 32rpx;
  box-shadow: 0 16rpx 48rpx #4277ae13;
}
.title { display: block; font-size: 44rpx; font-weight: 800; color: #1d395d; margin: 16rpx 0 24rpx; }
.text { display: block; color: #637a99; line-height: 1.85; font-size: 28rpx; }
.skills { margin-top: 32rpx; padding-top: 24rpx; border-top: 1rpx solid #edf1f8; }
.label { display: block; color: #4b84e9; font-size: 24rpx; font-weight: 700; margin-bottom: 8rpx; }
.value { color: #637a99; font-size: 28rpx; line-height: 1.7; }
.contact-line { display: block; margin-top: 24rpx; color: #8193ab; font-size: 26rpx; }
