<view class="container" wx:if="{{project}}">
  <view class="eyebrow">PROJECT / {{project.id}}</view>
  <text class="title">{{project.name}}</text>
  <view class="tagrow">
    <text wx:for="{{project.techs}}" wx:key="*this" class="tag">{{item}}</text>
    <text class="tag diff">{{project.level}}</text>
  </view>

  <view wx:if="{{gallery.length}}" class="section">
    <text class="section-title">项目展示图片</text>
    <image
      class="gallery-main"
      src="{{gallery[activeImage].url}}"
      mode="aspectFill"
      catchtap="previewImage"
      data-index="{{activeImage}}"
    />
    <scroll-view scroll-x class="thumbs" enable-flex enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{gallery}}"
        wx:key="id"
        wx:for-index="idx"
        class="thumb-wrap {{activeImage === idx ? 'active' : ''}}"
        catchtap="switchImage"
        data-index="{{idx}}"
      >
        <image class="thumb" src="{{item.url}}" mode="aspectFill" />
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{project.video}}" class="section">
    <text class="section-title">演示视频</text>
    <video class="video" src="{{project.video.url}}" controls poster="{{project.cover.url}}" />
  </view>

  <view class="section">
    <text class="section-title">项目简介</text>
    <text class="desc" user-select>{{project.description}}</text>
  </view>

  <view class="section">
    <text class="section-title">主要技术</text>
    <view class="tech-list">
      <text wx:for="{{project.techs}}" wx:key="*this" class="tech">{{item}}</text>
    </view>
  </view>

  <view class="section">
    <text class="section-title">核心功能</text>
    <view class="feature-list">
      <view
        wx:for="{{project.features}}"
        wx:key="id"
        class="feature-item"
        hover-class="feature-item-hover"
        catchtap="goFeature"
        data-id="{{item.id}}"
      >
        <text class="feature-name">✓ {{item.name}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>
