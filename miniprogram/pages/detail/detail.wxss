.title { display: block; font-size: 44rpx; font-weight: 800; color: #1d395d; margin: 12rpx 0; }
.tagrow { display: flex; flex-wrap: wrap; margin-bottom: 24rpx; }
.section { margin-top: 36rpx; }
.section-title { display: block; font-size: 30rpx; font-weight: 700; color: #1d395d; margin-bottom: 16rpx; }
.gallery-main { width: 100%; height: 380rpx; border-radius: 20rpx; border: 1rpx solid #e0eaf6; background: #ecf6ff; }
.thumbs { white-space: nowrap; margin-top: 12rpx; }
.thumb {
  display: inline-block; width: 160rpx; height: 100rpx; margin-right: 12rpx;
  border-radius: 12rpx; border: 3rpx solid transparent;
}
.thumb.active { border-color: #4e8bec; }
.video { width: 100%; height: 380rpx; border-radius: 20rpx; }
.desc { color: #667d9d; line-height: 1.8; font-size: 28rpx; }
.tech-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tech {
  background: #edf5ff; border: 1rpx solid #d5e6fa; color: #4f75ad;
  border-radius: 12rpx; padding: 12rpx 18rpx; font-size: 24rpx;
}
.feature-list { display: flex; flex-direction: column; gap: 12rpx; }
.feature-item {
  display: flex; justify-content: space-between; align-items: center;
  padding: 24rpx; background: #f7faff; border: 1rpx solid #e5edf8; border-radius: 16rpx; color: #526f99;
}
.arrow { color: #4c8ee7; font-size: 32rpx; }
