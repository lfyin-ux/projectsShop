<view class="container">
  <view class="header">
    <view class="brand-row">
      <image class="logo" src="/assets/logo-sm.png" mode="aspectFill" />
      <text class="brand">码上作品</text>
    </view>
    <text class="sub">用代码记录成长</text>
  </view>

  <view class="toolbar">
    <view class="search">
      <text class="search-icon">⌕</text>
      <input class="search-input" placeholder="搜索项目名称或技术栈" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
      <text wx:if="{{keyword}}" class="clear" bindtap="clearSearch">×</text>
    </view>
  </view>

  <scroll-view scroll-x class="filters" enable-flex>
    <view wx:for="{{categories}}" wx:key="*this"
      class="chip {{selected === item ? 'active' : ''}}"
      data-category="{{item}}" bindtap="onFilter">{{item}}</view>
  </scroll-view>

  <view class="section-head">
    <text class="title">精选项目</text>
    <text class="count">共 {{total}} 个项目</text>
  </view>

  <view wx:if="{{list.length}}" class="grid">
    <view wx:for="{{list}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="goDetail">
      <image wx:if="{{item.cover_url}}" class="cover" src="{{item.cover_url}}" mode="aspectFill" />
      <view wx:else class="cover placeholder"><text>{{item.category[0]}}</text></view>
      <view class="body">
        <view class="tagrow">
          <text wx:for="{{item.techs}}" wx:for-item="tech" wx:key="*this" class="tag">{{tech}}</text>
          <text class="tag diff">{{item.level}}</text>
        </view>
        <text class="name">{{item.name}}</text>
        <text class="summary">{{item.summary}}</text>
        <view class="foot"><text>查看项目详情</text><text class="arrow">↗</text></view>
      </view>
    </view>
  </view>
  <view wx:else class="empty">
    <text>没有找到相关项目，换个关键词试试。</text>
    <view wx:if="{{keyword}}" class="clear-btn" bindtap="clearSearch">清空搜索</view>
  </view>
</view>
