.header { padding: 24rpx 0 16rpx; display: flex; justify-content: space-between; align-items: center; }
.brand-row { display: flex; align-items: center; gap: 16rpx; }
.logo { width: 64rpx; height: 64rpx; border-radius: 16rpx; }
.brand { font-size: 36rpx; font-weight: 900; color: #203d72; letter-spacing: 2rpx; }
.sub { font-size: 22rpx; color: #7185a4; }

.toolbar { margin: 16rpx 0; }
.search {
  display: flex; align-items: center; gap: 12rpx;
  background: #fff; border: 1rpx solid #dae5f3; border-radius: 24rpx;
  padding: 0 24rpx; box-shadow: 0 8rpx 24rpx #416ca90d;
}
.search-icon { color: #6990c6; font-size: 36rpx; }
.search-input { flex: 1; height: 88rpx; color: #203a5b; }
.clear { color: #8fa1b7; font-size: 36rpx; padding: 10rpx; }

.filter-block { margin-bottom: 16rpx; }
.filter-label {
  display: block;
  font-size: 22rpx;
  color: #8193ab;
  margin-bottom: 10rpx;
  padding-left: 4rpx;
}
.filters { white-space: nowrap; margin-bottom: 4rpx; }
.chip {
  display: inline-block; padding: 16rpx 28rpx; margin-right: 14rpx;
  background: #fff; border: 1rpx solid #dde7f4; border-radius: 999rpx; color: #657a98;
}
.chip.active { background: #eaf3ff; border-color: #7baaf1; color: #3472dd; }

.section-head { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 20rpx; }
.title { font-size: 36rpx; font-weight: 700; color: #203756; }
.count { font-size: 24rpx; color: #8193ab; }

.grid { display: flex; flex-direction: column; gap: 28rpx; }

.card {
  background: #fff;
  border: 1rpx solid #e1e9f5;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 36rpx #40689910;
}
.card-hover { transform: scale(0.995); opacity: 0.96; }

.cover-wrap {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 56.25%;
  background: linear-gradient(135deg, #e8f2ff, #edf0ff);
  overflow: hidden;
}
.cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.cover.placeholder {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #dcecff, #e9ecff);
}
.placeholder-icon {
  font-size: 72rpx;
  font-weight: 800;
  color: #5a94e8;
  opacity: 0.5;
}
.cover-badge {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  padding: 8rpx 18rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #3f7de4;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx #3f7de420;
}

.body { padding: 24rpx 28rpx 20rpx; }

.meta-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.tagrow { display: flex; flex-wrap: wrap; gap: 8rpx; flex: 1; min-width: 0; }
.tag {
  display: inline-block;
  color: #4a82c5;
  background: #eef6ff;
  border: 1rpx solid #d6eafa;
  border-radius: 8rpx;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tag.more { color: #6a7ece; background: #f0f2ff; border-color: #e2e5ff; }
.level-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #4abf9a;
  background: #eefaf5;
  border: 1rpx solid #c8edd9;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  white-space: nowrap;
}

.name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #203756;
  line-height: 1.4;
  margin-bottom: 10rpx;
}
.summary {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 24rpx;
  color: #71829d;
  line-height: 1.65;
  min-height: 78rpx;
}

.foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1f8;
}
.foot-text { color: #8b9ab1; font-size: 22rpx; }
.arrow {
  color: #4c8ae8;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}

.empty {
  padding: 80rpx 40rpx;
  text-align: center;
  color: #7e8fa9;
  border: 2rpx dashed #d5e2f3;
  border-radius: 24rpx;
}
.clear-btn { margin-top: 20rpx; color: #4c8ae8; font-size: 26rpx; }
