<view class="container" wx:if="{{feature}}">
  <view class="back" bindtap="goBack">← 返回{{feature.project_name}}</view>
  <view class="eyebrow">FEATURE / {{feature.sort_order + 1}}</view>
  <text class="title">{{feature.name}}</text>
  <text class="desc">{{feature.description}}</text>

  <view wx:if="{{feature.images.length}}" class="section">
    <text class="section-title">功能页面截图</text>
    <view wx:for="{{feature.images}}" wx:key="id" class="shot">
      <image class="shot-img" src="{{item.url}}" mode="widthFix" bindtap="previewImage" data-url="{{item.url}}" />
      <text wx:if="{{item.caption}}" class="caption">{{item.caption}}</text>
    </view>
  </view>

  <view wx:if="{{steps.length}}" class="section">
    <text class="section-title">功能流程</text>
    <view class="steps">
      <view wx:for="{{steps}}" wx:key="*this" class="step">
        <text class="num">{{index + 1}}</text>
        <text class="text">{{item}}</text>
      </view>
    </view>
  </view>
</view>
